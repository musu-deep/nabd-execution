.focus-meta{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0}.pill{padding:8px 11px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:999px;font-size:12px}
    .focus-actions{display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:2}.focus-actions .btn{background:#fff;color:#073d35;border:0;font-weight:700}.focus-actions .btn.alt{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.22)}
    .capacity{padding:22px;min-height:310px}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.section-title h3{margin:0;font-size:18px}.section-title small{color:var(--muted)}
    .gauge-wrap{display:grid;place-items:center;margin:6px 0 18px}.gauge{--p:72;width:190px;height:190px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--primary) calc(var(--p)*1%),rgba(140,170,160,.18) 0);position:relative}.gauge::before{content:"";position:absolute;width:145px;height:145px;border-radius:50%;background:var(--panel-solid);box-shadow:inset 0 0 0 1px var(--line)}.gauge .inside{position:relative;text-align:center}.gauge strong{font-size:39px;display:block}.gauge small{color:var(--muted)}
    .capacity-note{background:rgba(217,164,65,.12);border:1px dashed rgba(217,164,65,.55);padding:13px;border-radius:16px;font-size:13px;line-height:1.7}
    .tasks-section{margin-top:20px;padding:22px}.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{border:1px solid var(--line);background:transparent;color:var(--muted);padding:8px 11px;border-radius:999px}.filter.active{background:var(--primary);color:#fff;border-color:var(--primary)}
    .task-list{display:grid;gap:11px;margin-top:17px}.task-row{display:grid;grid-template-columns:auto 1fr auto auto;gap:14px;align-items:center;padding:15px;border:1px solid var(--line);background:rgba(255,255,255,.45);border-radius:17px;transition:.2s}.dark .task-row{background:rgba(255,255,255,.03)}.task-row:hover{transform:translateY(-2px);border-color:var(--primary)}
    .priority-dot{width:11px;height:45px;border-radius:99px}.p-high{background:linear-gradient(#e75c5c,#b83232)}.p-medium{background:linear-gradient(#f0b65d,#d97921)}.p-low{background:linear-gradient(#54c9ad,#18876b)}
    .task-main h4{margin:0 0 5px;font-size:15px}.task-main p{margin:0;color:var(--muted);font-size:12px}.task-time{text-align:center}.task-time strong{display:block;font-size:14px}.task-time small{color:var(--muted)}
    .progress-mini{width:90px}.bar{height:8px;background:rgba(130,160,150,.18);border-radius:99px;overflow:hidden}.bar span{display:block;height:100%;background:linear-gradient(90deg,var(--primary),var(--primary-2));border-radius:inherit}.progress-mini small{display:block;text-align:center;margin-top:5px;color:var(--muted)}
    .lower{grid-template-columns:1fr 1fr;margin-top:20px}.timeline-card,.report-card{padding:22px}.timeline{display:grid;gap:13px}.timeline-item{display:grid;grid-template-columns:75px 16px 1fr;gap:10px;align-items:start}.timeline-item time{font-weight:700;font-size:13px;color:var(--muted)}.node{width:12px;height:12px;margin-top:4px;border-radius:50%;background:var(--primary);box-shadow:0 0 0 5px rgba(15,145,127,.12)}.timeline-item:not(:last-child) .node::after{content:"";display:block;width:2px;height:48px;background:var(--line);margin:13px auto 0}.timeline-item h4{margin:0 0 4px;font-size:14px}.timeline-item p{margin:0;color:var(--muted);font-size:12px}
    .report-bars{display:grid;gap:13px}.metric-line{display:grid;grid-template-columns:130px 1fr 46px;gap:10px;align-items:center;font-size:13px}.metric-line strong{text-align:left}.report-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:19px}
    .ticker{
      position:fixed;right:286px;top:50%;transform:translateY(-50%);width:70px;height:430px;
      background:linear-gradient(180deg,#0a675a,#073d35);color:#fff;border-radius:24px 0 0 24px;
      box-shadow:0 20px 50px rgba(6,55,47,.28);z-index:45;overflow:hidden;border:1px solid rgba(255,255,255,.14)
    }
    .ticker-head{height:68px;display:grid;place-items:center;border-bottom:1px solid rgba(255,255,255,.14);font-size:23px}.ticker-track{height:calc(100% - 68px);overflow:hidden;position:relative}.ticker-inner{position:absolute;inset:0;display:flex;flex-direction:column;gap:22px;align-items:center;padding:18px 0;animation:verticalTicker 22s linear infinite}.ticker:hover .ticker-inner{animation-play-state:paused}.ticker-item{writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;font-size:12px;opacity:.84;cursor:pointer;padding:8px 4px}.ticker-item:hover{opacity:1;color:#ffe6a8}.ticker-item b{color:#ffd67e;margin-bottom:7px}
    @keyframes verticalTicker{0%{transform:translateY(0)}100%{transform:translateY(-55%)}}
    .modal-backdrop{position:fixed;inset:0;background:rgba(1,20,17,.58);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px;z-index:100}.modal-backdrop.open{display:flex}.mo